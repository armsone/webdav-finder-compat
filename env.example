# WebDAV Compatibility Gateway Environment Configuration
# Target Host: Synology DS1821+ (DSM 7.4.1)
# Baseline Topology Configuration

# Image & Container Tag (pinned to aiohttp 3.14.5, avoiding unversioned 'latest')
GATEWAY_IMAGE=webdav-compat-gateway:3.14.5

# Host loopback binding port (strictly 127.0.0.1)
GATEWAY_LOOPBACK_PORT=18080

# Internal container listening configuration
WEBDAV_LISTEN_HOST=0.0.0.0
WEBDAV_LISTEN_PORT=8080

# Upstream WebDAV server endpoint (Synology WebDAV Server HTTP listener on host port 5005)
WEBDAV_UPSTREAM_URL=http://host.docker.internal:5005

# Upstream TLS certificate verification (default true)
WEBDAV_TLS_VERIFY=true

# Maximum XML response buffering size in bytes (10MB default)
WEBDAV_MAX_XML_SIZE=10485760

# Public origin mapping to preserve COPY/MOVE/If URLs and Location redirects behind DSM
WEBDAV_PUBLIC_ORIGIN=https://nas.example.com:5006
